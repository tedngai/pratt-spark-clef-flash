# Clef-Flash project configuration.
# Sourced by start_clef.sh / stop_clef.sh / prefetch_clef.sh, and passed to
# docker compose via --env-file (and to systemd via the unit).

CONTAINER_NAME=clef-flash
SERVED_MODEL_NAME=clef-flash
MODEL_ID=Cloudflare/clef-flash

# Host port. 8000 is intentionally avoided because other local services use it.
PORT=8001

# Image built by start_clef.sh / prefetch_clef.sh / docker compose build.
CLEF_IMAGE=clef-flash:latest
# Pinned public base image (multi-arch manifest list digest). Pullable on a new host.
BASE_IMAGE=vllm/vllm-openai@sha256:9fe761ad1e8258a5e8f1c28243b1567c19b0a78e3a909c72611fdd1771f0f966
PULL_POLICY=missing

# transformers release to pin inside the image. 5.10.2 is what the model card used.
TRANSFORMERS_VERSION=5.10.2

# Fused-kernel build. INSTALL_KERNELS=1 compiles flash-linear-attention + causal-conv1d
# to enable transformers' Qwen3.5 fast path. CUDA_ARCH_LIST must match the target GPU
# (GB10 / DGX Spark = 12.1; H100 = 9.0; RTX 50 = 12.0). MAX_JOBS limits compile jobs.
INSTALL_KERNELS=1
CUDA_ARCH_LIST=12.1
MAX_JOBS=8

# Model/runtime options.
CLEF_DEVICE=cuda
CLEF_MAX_LENGTH=16384
# Run one synthetic decision at startup so Triton/CUDA kernels compile before real
# traffic (otherwise the first request pays a ~20 s autotune penalty).
CLEF_WARMUP=1
LOG_LEVEL=info

# Compose restart policy: unless-stopped keeps it up across reboots/crashes.
RESTART_POLICY=unless-stopped

# Host-side caches, relative to the project directory (portable across servers).
DATA_ROOT=./data
HF_HOME_HOST=./data/huggingface

# Hugging Face transfer tuning.
HF_HUB_ENABLE_HF_TRANSFER=1
HF_XET_HIGH_PERFORMANCE=1
# If Xet downloads hang on your network, uncomment the next line and re-run prefetch.
# HF_HUB_DISABLE_XET=1

# Optional Hugging Face token for gated/private models (not required for clef-flash).
# HF_TOKEN=hf_xxx

# --- Hardened server (server_hardened.py) --------------------------------
# Entry point inside the image; set to server.py to revert to the stock server.
CLEF_SERVER_FILE=server_hardened
# Dynamic micro-batching: gather up to BATCH_MAX requests within BATCH_WAIT_MS
# into a single forward pass. QUEUE_MAX bounds the waiting queue; extra
# requests get 429 + Retry-After instead of unbounded latency.
QUEUE_MAX=64
BATCH_MAX=8
BATCH_WAIT_MS=10
# Optional API key: when set, POST endpoints require Authorization: Bearer <key>
# (GET /health, /ready, /stats stay open for probes/monitoring).
# CLEF_API_KEY=
